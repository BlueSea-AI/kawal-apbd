# Kawal APBD — Environment Variables (Optional)
# Copy to .env.local or export in your shell. Never commit secrets to git.

# Optional: BPS RI Official WebAPI Key (https://webapi.bps.go.id/developer/)
# If omitted, scripts/etl_pipeline.py automatically ingests BPS official public
# statistics tables without authentication.
BPS_API_KEY=

# Optional: Gemini API Key for batch editorial audit generation
# Used only by scripts/generate_ai_audits.py (never exposed to browser client).
GEMINI_API_KEY=
